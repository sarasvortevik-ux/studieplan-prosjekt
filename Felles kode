import json


class Studieplan:
    """Innkapsler all logikk og datastrukturer for studieplanen."""

    def __init__(self):
        self.emner = {}  # kode -> {"semester": "Høst/Vår", "poeng": int}
        self.planer = {"Standard": [[] for _ in range(6)]}  # navn -> 6 semestre

    def _hent_plan(self, plan_navn):
        plan = self.planer.get(plan_navn)
        if plan is None:
            print(f"Fant ikke studieplanen '{plan_navn}'.")
        return plan

    def tilgjengelige_planer(self):
        return list(self.planer.keys())

    # Menyvalg 1
    def legg_til_emne(self, kode, semester, poeng):
        if kode in self.emner:
            print("Emnet finnes allerede.")
            return
        semester = semester.strip().capitalize()
        if semester not in {"Høst", "Vår"}:
            print("Semester må være Høst eller Vår.")
            return
        self.emner[kode] = {"semester": semester, "poeng": poeng}
        print("Emnet er lagret.")

    # Menyvalg 2
    def legg_til_i_plan(self, kode, plan_navn, semnr):
        if kode not in self.emner:
            print("Emnet finnes ikke.")
            return
        if not 1 <= semnr <= 6:
            print("Velg et semester mellom 1 og 6.")
            return

        plan = self._hent_plan(plan_navn)
        if plan is None:
            return

        emneinfo = self.emner[kode]
        if kode in [emne for semester in plan for emne in semester]:
            print("Emnet er allerede lagt til.")
            return
        if emneinfo["semester"] == "Høst" and semnr not in {1, 3, 5}:
            print("Høstemner kan bare legges til i 1, 3 eller 5.")
            return
        if emneinfo["semester"] == "Vår" and semnr not in {2, 4, 6}:
            print("Våremner kan bare legges til i 2, 4 eller 6.")
            return

        total = sum(self.emner[emne]["poeng"] for emne in plan[semnr - 1])
        if total + emneinfo["poeng"] > 30:
            print("Semesteret har ikke plass til flere studiepoeng.")
            return

        plan[semnr - 1].append(kode)
        print(f"Emnet ble lagt til i semester {semnr} i studieplanen '{plan_navn}'.")

    # Menyvalg 3
    def fjern_fra_plan(self, kode, plan_navn):
        plan = self._hent_plan(plan_navn)
        if plan is None:
            return
        for semester in plan:
            if kode in semester:
                semester.remove(kode)
                print(f"Emnet {kode} ble fjernet fra studieplanen '{plan_navn}'.")
                return
        print("Emnet finnes ikke i denne studieplanen.")

    # Menyvalg 4
    def skriv_ut_emner(self):
        print("\nRegistrerte emner:")
        for kode, data in self.emner.items():
            print(f"{kode} – {data['semester']} – {data['poeng']} studiepoeng")

    # Menyvalg 5
    def lag_ny_plan(self, plan_navn):
        if not plan_navn:
            print("Studieplanen må ha et navn.")
            return
        if plan_navn in self.planer:
            print(f"Studieplanen '{plan_navn}' finnes allerede og blir nå tømt.")
        else:
            print(f"Ny studieplan '{plan_navn}' er opprettet.")
        self.planer[plan_navn] = [[] for _ in range(6)]

    # Menyvalg 6
    def skriv_ut_studieplan(self, plan_navn):
        plan = self._hent_plan(plan_navn)
        if plan is None:
            return
        print(f"\nStudieplan '{plan_navn}':")
        for i, semester in enumerate(plan, start=1):
            print(f"Semester {i}: {', '.join(semester)}")

    # Menyvalg 7
    def sjekk_gyldighet(self, plan_navn):
        plan = self._hent_plan(plan_navn)
        if plan is None:
            return
        print(f"\nGyldighetssjekk for '{plan_navn}':")
        for i, semester in enumerate(plan, start=1):
            total = sum(self.emner[emne]["poeng"] for emne in semester)
            if total != 30:
                print(f"Semester {i} er ugyldig: {total} studiepoeng")
            else:
                print(f"Semester {i} er gyldig")

    # Menyvalg 8
    def finn_planer_med_emne(self, kode):
        if kode not in self.emner:
            print("Emnet finnes ikke i registeret.")
            return []
        funn = [
            plan_navn
            for plan_navn, plan in self.planer.items()
            if any(kode in semester for semester in plan)
        ]
        if funn:
            print(f"Emnet {kode} finnes i studieplanene: {', '.join(funn)}")
        else:
            print(f"Emnet {kode} finnes ikke i noen studieplaner.")
        return funn

    # Menyvalg 9
    def lagre_til_fil(self, filnavn="studieplan.txt"):
        data = {"emner": self.emner, "planer": self.planer}
        with open(filnavn, "w") as fil:
            json.dump(data, fil, indent=2, ensure_ascii=False)
        print("Data lagret til fil.")

    # Menyvalg 10
    def les_fra_fil(self, filnavn="studieplan.txt"):
        try:
            with open(filnavn, "r") as fil:
                data = json.load(fil)
        except FileNotFoundError:
            print(f"Fant ikke filen {filnavn}.")
            return
        except json.JSONDecodeError:
            print("Kunne ikke lese data fra filen. Kontroller at formatet er korrekt.")
            return

        self.emner = data.get("emner", {})
        innleste_planer = data.get("planer", {})
        if not innleste_planer:
            innleste_planer = {"Standard": [[] for _ in range(6)]}

        rensede_planer = {}
        for plan_navn, semestre in innleste_planer.items():
            rensede_semestre = []
            for i in range(6):
                if isinstance(semestre, dict):
                    # Skulle vi ende opp med et dict-indexert oppsett fra eldre fil.
                    semester = semestre.get(str(i), []) or semestre.get(i, [])
                else:
                    semester = semestre[i] if i < len(semestre) else []
                if isinstance(semester, list):
                    rensede_semestre.append([str(emne) for emne in semester if emne])
                elif isinstance(semester, str):
                    rensede_semestre.append([semester] if semester else [])
                else:
                    rensede_semestre.append([])
            rensede_planer[plan_navn] = rensede_semestre

        self.planer = rensede_planer
        print("Data hentet fra fil.")


def vis_meny():
    print("\nMENY:")
    print("1. Lag et nytt emne")
    print("2. Legg til et emne i en studieplan")
    print("3. Fjern et emne fra en studieplan")
    print("4. Skriv ut ei liste over alle registrerte emner")
    print("5. Lag en ny tom studieplan")
    print("6. Skriv ut en studieplan med hvilke emner som er i hvert semester")
    print("7. Sjekk om en studieplan er gyldig eller ikke")
    print("8. Finn hvilke studieplaner som bruker et oppgitt emne")
    print("9. Lagre emnene og studieplanene til fil")
    print("10. Les inn emnene og studieplanene fra fil")
    print("11. Avslutt")


def hovedprogram():
    plan = Studieplan()
    while True:
        vis_meny()
        valg = input("Velg menyvalg: ")
        if valg == "1":
            kode = input("Emnekode: ")
            semester = input("Semester (Høst/Vår): ")
            try:
                poeng = int(input("Studiepoeng: "))
            except ValueError:
                print("Studiepoeng må være et tall.")
                continue
            plan.legg_til_emne(kode, semester, poeng)
        elif valg == "2":
            if not plan.planer:
                print("Ingen studieplaner tilgjengelig. Lag en ny først.")
                continue
            kode = input("Hvilken emnekode vil du legge til? ")
            planliste = ", ".join(plan.tilgjengelige_planer())
            plan_navn = input(f"Hvilken studieplan ({planliste}): ").strip() or "Standard"
            try:
                semnr = int(input("Hvilket semester (1-6)? "))
            except ValueError:
                print("Semester må oppgis som et tall.")
                continue
            plan.legg_til_i_plan(kode, plan_navn, semnr)
        elif valg == "3":
            if not plan.planer:
                print("Ingen studieplaner tilgjengelig.")
                continue
            kode = input("Hvilken emnekode vil du fjerne? ")
            planliste = ", ".join(plan.tilgjengelige_planer())
            plan_navn = input(f"Hvilken studieplan ({planliste}): ").strip() or "Standard"
            plan.fjern_fra_plan(kode, plan_navn)
        elif valg == "4":
            plan.skriv_ut_emner()
        elif valg == "5":
            plan_navn = input("Navn på studieplan som skal lages/tømmes: ").strip()
            plan.lag_ny_plan(plan_navn or "Standard")
        elif valg == "6":
            if not plan.planer:
                print("Ingen studieplaner tilgjengelig.")
                continue
            planliste = ", ".join(plan.tilgjengelige_planer())
            plan_navn = input(f"Hvilken studieplan vil du skrive ut ({planliste}): ").strip() or "Standard"
            plan.skriv_ut_studieplan(plan_navn)
        elif valg == "7":
            if not plan.planer:
                print("Ingen studieplaner tilgjengelig.")
                continue
            planliste = ", ".join(plan.tilgjengelige_planer())
            plan_navn = input(f"Hvilken studieplan vil du sjekke ({planliste}): ").strip() or "Standard"
            plan.sjekk_gyldighet(plan_navn)
        elif valg == "8":
            kode = input("Hvilken emnekode vil du søke etter? ")
            plan.finn_planer_med_emne(kode)
        elif valg == "9":
            plan.lagre_til_fil()
        elif valg == "10":
            plan.les_fra_fil()
        elif valg == "11":
            print("Avslutter...")
            break
        else:
            print("Ugyldig valg.")


if __name__ == "__main__":
    hovedprogram()
